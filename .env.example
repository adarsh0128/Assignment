# Django secret used to sign cookies and JWTs. Use a long random value in production.
DJANGO_SECRET_KEY=replace-with-random-secret

# Comma-separated backend hosts, for example esg-backend.onrender.com.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated frontend origins trusted for CSRF-sensitive endpoints.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Comma-separated frontend origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# PostgreSQL connection settings.
POSTGRES_DB=esg_platform
POSTGRES_USER=esg_platform
POSTGRES_PASSWORD=esg_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# React API base URL exposed by Vite.
VITE_API_BASE_URL=http://localhost:8000/api/v1
